# Settings baked into the installer stick by build-usb.sh.

VENTOY_VERSION=1.1.18

# AlmaLinux major version; the newest point-release boot ISO is used.
ALMA_MAJOR=10

# Fedora release for the Silverblue base. Keep it equal to the Fedora version
# the Bazzite image is built on (Bazzite stable = 45 as of 2026-11-13), so the
# first-boot rebase is not also a release upgrade.
FEDORA_VERSION=45

# Image the Silverblue install rebases to on first boot.
# Variants: bazzite, bazzite-nvidia, bazzite-gnome, bazzite-gnome-nvidia, ...
BAZZITE_IMAGE=ghcr.io/ublue-os/bazzite:stable

# Optional: pin which physical SSD gets which distro, by serial number
# (lsblk -dno NAME,SERIAL). Set both or neither. With neither, Alma goes on
# the first internal disk in kernel name order (e.g. nvme0n1).
ALMA_DISK_SERIAL=""
BAZZITE_DISK_SERIAL=""
